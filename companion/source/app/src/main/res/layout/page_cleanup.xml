<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_variable" android:text="@string/cleanup_page_title" android:textColor="@color/text_primary" android:textSize="27sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/hero_card_height" android:layout_marginTop="22dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
            <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_icon_tile" android:padding="18dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/overlay_title" android:src="@drawable/ic_monitor" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cleanup_virtual_display_short" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/overlay_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/success" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:text="@string/cleanup_virtual_display_detail" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/overlay_value" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" />
            </LinearLayout>
            <Button android:id="@+id/cleanup_overlay_button" style="@style/Widget.DX.Button.Secondary" android:layout_width="82dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/cleanup_overlay_button_short" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/hero_card_height" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
            <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_icon_tile" android:padding="18dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/stay_awake_title" android:src="@drawable/ic_sleep" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cleanup_stay_awake_short" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/stay_awake_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/success" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:text="@string/cleanup_stay_awake_detail" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/stay_awake_value" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" />
            </LinearLayout>
            <Button android:id="@+id/cleanup_stay_awake_button" style="@style/Widget.DX.Button.Secondary" android:layout_width="82dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/cleanup_stay_awake_button_short" />
        </LinearLayout>

        <Button android:id="@+id/cleanup_both_button" style="@style/Widget.DX.Button.Primary" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:text="@string/cleanup_both_button_short" android:textSize="17sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_action_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/guardian_disconnect_cleanup_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:text="@string/guardian_disconnect_cleanup_short" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <Spinner android:id="@+id/guardian_cleanup_delay" android:layout_width="118dp" android:layout_height="50dp" android:layout_marginStart="10dp" android:background="@drawable/bg_secondary_button" android:entries="@array/guardian_cleanup_delay_entries" android:paddingStart="12dp" android:paddingEnd="12dp" android:spinnerMode="dropdown" />
        </LinearLayout>

        <Button android:id="@+id/refresh_button" style="@style/Widget.DX.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="@string/refresh_button" />
    </LinearLayout>
</ScrollView>
