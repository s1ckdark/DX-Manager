<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_variable" android:text="@string/settings_page_title" android:textColor="@color/text_primary" android:textSize="27sp" android:textStyle="bold" />

        <LinearLayout android:id="@+id/settings_permission_card" android:layout_width="match_parent" android:layout_height="@dimen/hero_card_height" android:layout_marginTop="22dp" android:background="@drawable/bg_status_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
            <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_status_icon" android:padding="18dp"><ImageView android:id="@+id/settings_permission_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/permission_title" android:src="@drawable/ic_settings" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/permission_title_short" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/settings_permission_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/settings_permission_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="2" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/tile_widget_settings_title" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/tile_widget_settings_description_short" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <CheckBox android:id="@+id/tile_widget_overlay" android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="13dp" android:background="@drawable/bg_option_row" android:button="@null" android:drawableStart="@drawable/checkbox_indicator" android:drawablePadding="16dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="16dp" android:text="@string/tile_widget_overlay" android:textColor="@color/text_primary" android:textSize="15sp" />
        <CheckBox android:id="@+id/tile_widget_stay_awake" android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="10dp" android:background="@drawable/bg_option_row" android:button="@null" android:drawableStart="@drawable/checkbox_indicator" android:drawablePadding="16dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="16dp" android:text="@string/tile_widget_stay_awake" android:textColor="@color/text_primary" android:textSize="15sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_info_card" android:orientation="vertical" android:padding="17dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quick_surface_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/widget_tile_hint" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
